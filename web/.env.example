# Copiá este archivo como .env.local y completá los valores (.env.local NO se sube a GitHub).

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# "Publishable key" (sb_publishable_...) o, en proyectos viejos, la "anon key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ⚠️ Secreta ("Secret key" / service_role): solo en el servidor, nunca en el navegador. Se usa más adelante.
SUPABASE_SECRET_KEY=
